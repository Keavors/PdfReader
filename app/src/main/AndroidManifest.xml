<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Список прочитанных документов не выгружается ни в облачный бэкап,
         ни на новое устройство: подробности в data_extraction_rules.xml. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PdfReader">

        <!-- Приложение, запущенное с иконки: список файлов, из него документ,
             "назад" из документа - снова к списку.

             configChanges: поворот экрана не пересоздаёт активити, поэтому
             документ не перечитывается заново и не теряет масштаб с прокруткой. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Документ из другого приложения: мессенджера, почты, проводника.

             Открывается поверх того, кто его прислал, в его же задаче: своей
             карточки в недавних приложениях у читалки не появляется, а "назад"
             возвращает прямо в переписку.

             Если отправитель всё же требует новую задачу, taskAffinity=""
             даёт документу отдельную, а не кладёт его поверх списка файлов:
             "назад" и тогда ведёт к отправителю. autoRemoveFromRecents убирает
             такую задачу из недавних, как только документ закрыт, а singleTop
             не даёт ей копить документы стопкой. -->
        <activity
            android:name=".ViewerActivity"
            android:autoRemoveFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity="">

            <!-- Чтобы приложение предлагалось при открытии PDF из проводника -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>

            <!-- Часть проводников и мессенджеров не знает тип файла и отдаёт его
                 как поток байтов - для таких опираемся на расширение. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="application/octet-stream" />
                <data android:pathPattern=".*\\.pdf" />
                <data android:pathPattern=".*\\.PDF" />
            </intent-filter>

            <!-- "Поделиться -> PDF Reader" из другого приложения -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

        <!-- Копии документов лежат в приватном хранилище: отдать такой файл
             другому приложению можно только через провайдера, иначе система
             запрещает выпускать наружу ссылку вида file://. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
