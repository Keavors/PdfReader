<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Имя стиля должно совпадать с android:theme в манифесте.
         Цвета системных баров не задаём: с targetSdk 35 и выше система их
         игнорирует, а бары и так прозрачные из-за рисования от края до края. -->
    <style name="Theme.PdfReader" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/reader_background</item>
        <!-- В альбомной ориентации рисуем и под вырезом камеры, без чёрных полос -->
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>
    </style>

</resources>
